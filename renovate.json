{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Denver",
  "labels": [
    "renovate"
  ],
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "No Python pre-releases: 3.15 is alpha (dbus_next breaks on it). Raise once 3.15.0 final ships.",
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
